# ── SmartCut 本地后端配置 ─────────────────────────────────────────────
# 复制为 .env 后按需修改。所有变量使用 SMARTCUT_ / DEEPSEEK_ 前缀。
SMARTCUT_WORKSPACE_ROOT=./workspace
SMARTCUT_FFMPEG_BIN=ffmpeg
SMARTCUT_FFPROBE_BIN=ffprobe
SMARTCUT_TOOL_TIMEOUT_SECONDS=120
SMARTCUT_RENDER_TIMEOUT_SECONDS=900
SMARTCUT_MAX_WORKERS=2
# 活动/排队 Job 上限；0=不限制。满时 API 返回 422，避免队列无限堆积。
SMARTCUT_MAX_PENDING_JOBS=64
SMARTCUT_MAX_UPLOAD_MB=4096
# 可重算缓存磁盘上限（MB，0=不限）；只淘汰 frames/scenes 等可重算产物
SMARTCUT_CACHE_MAX_MB=2048
# 编辑偏好作用域：source=仅当前素材；project=跨素材复用
SMARTCUT_PREFERENCE_SCOPE=source
# 工具审计保留天数（0=永久）；任务结束时清理更早记录
SMARTCUT_TOOL_AUDIT_RETENTION_DAYS=30
SMARTCUT_FFMPEG_CONCURRENCY=2
SMARTCUT_CPU_CONCURRENCY=2
SMARTCUT_LLM_CONCURRENCY=4
SMARTCUT_TRANSCRIBE_CHUNK_SECONDS=300
SMARTCUT_TRANSCRIBE_CHUNK_OVERLAP_SECONDS=1
# 0=auto：CPU 且 transcriber 支持 clone 时最多 2 worker；GPU 默认 1
SMARTCUT_TRANSCRIBE_WORKERS=0
SMARTCUT_TRANSCRIBE_SILENCE_RMS=0.002
SMARTCUT_TRANSCRIBE_SILENCE_MIN_SECONDS=0.5
# whisper 隔离进程单次请求超时（含模型加载）；超时直接杀进程
SMARTCUT_WHISPER_WORKER_TIMEOUT_SECONDS=1800
SMARTCUT_WHISPER_WORKER_RETRIES=1
# 质量/人脸最多分析帧数；优先保留镜头切点附近帧（0=不限制）
SMARTCUT_PERCEPTION_MAX_FRAMES=1200
# 质量/人脸进程池整批 watchdog 秒数；超时终止整个池
SMARTCUT_PERCEPTION_PROCESS_POOL_TIMEOUT_SECONDS=600
SMARTCUT_WAVEFORM_BUCKETS=2000
SMARTCUT_CHAPTER_TARGET_SECONDS=300

# 字幕样式（桌面设置页会覆盖）
SMARTCUT_CAPTION_FONT_NAME=Microsoft YaHei
SMARTCUT_CAPTION_FONT_SIZE=22
SMARTCUT_CAPTION_COLOR="#FFFFFF"
SMARTCUT_CAPTION_POSITION=bottom

# 桌面客户端数据目录（默认 %LOCALAPPDATA%\SmartCut）
# SMARTCUT_DATA_DIR=

# 无 Key 时使用规则规划器跑完整 DAG；false 则仅做分析/转写
SMARTCUT_PLANNER_OFFLINE_FALLBACK=true

# Orchestrator（Magnetic-One 风格多智能体）
SMARTCUT_ORCHESTRATOR_MAX_PARALLEL=4
SMARTCUT_ORCHESTRATOR_MAX_ROUNDS=64
SMARTCUT_ORCHESTRATOR_USE_LLM=true
# 最终决策是否额外调用 LLM 生成自然语言总结（默认关闭，使用确定性答案）
SMARTCUT_LLM_DECISION_SUMMARY=false

# DeepSeek（OpenAI 兼容）。不配置时 /plan 返回 503，手工 IR 渲染不受影响。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120

# 转写模型（需 pip install -e ".[transcribe]"）
SMARTCUT_WHISPER_MODEL=base
# 指向本地模型目录；桌面安装包会自动设置为内嵌模型路径
SMARTCUT_WHISPER_MODEL_PATH=
SMARTCUT_WHISPER_DEVICE=cpu
SMARTCUT_WHISPER_COMPUTE_TYPE=int8

# 桌面客户端：DeepSeek Key 优先存 Windows Credential Manager；
# 开发态可继续使用上面的 DEEPSEEK_API_KEY 或 .env。

# ── Phase 2：候选 / Critic ─────────────────────────────────────────────
SMARTCUT_CANDIDATE_TARGET_SECONDS=30
SMARTCUT_CANDIDATE_MAX=300
SMARTCUT_CANDIDATE_RETRIEVAL_LIMIT=60
SMARTCUT_CRITIC_MAX_SEGMENT_SECONDS=90
SMARTCUT_CRITIC_QUALITY_PADDING=0.5
SMARTCUT_AUDIO_FILLER_WORDS=um,uh,erm,嗯,呃,那个
SMARTCUT_AUDIO_FILLER_PADDING=0.05
SMARTCUT_AUDIO_MIN_SEGMENT_SECONDS=0.4
SMARTCUT_MIX_TIMEOUT_SECONDS=600

# ── 可选人声分离（不随主程序打包） ───────────────────────────────────
# 外部命令；留空时尝试 PATH 中的 demucs 或 Python 模块。
# 示例：SMARTCUT_DEMUCS_COMMAND=C:\tools\demucs\python.exe C:\tools\demucs\separate.py
SMARTCUT_DEMUCS_COMMAND=
SMARTCUT_DEMUCS_MODEL=htdemucs
SMARTCUT_DEMUCS_TIMEOUT_SECONDS=1800

# ── Phase 3：硬件编码 / 代理 / 视觉 ───────────────────────────────────
# auto: 探测 NVENC/QSV/AMF，失败自动回退 libx264；off: 只用 libx264
SMARTCUT_HARDWARE_ENCODING=auto
SMARTCUT_ENCODER_PRIORITY=h264_nvenc,h264_qsv,h264_amf,libx264
SMARTCUT_PROXY_HEIGHT=720

# 视觉证据层：桌面 auto 使用 Qt OpenGL，失败/无 GL 自动回退 CPU
SMARTCUT_VIEW_EVIDENCE_ENABLED=true
SMARTCUT_VIEW_RENDERER=auto
SMARTCUT_VIEW_MAX_IMAGES=7
SMARTCUT_VIEW_MAX_WINDOWS=4
SMARTCUT_VIEW_FPS=2
SMARTCUT_VIEW_WINDOW_PADDING_SECONDS=2
SMARTCUT_VIEW_TILE_WIDTH=384
SMARTCUT_VIEW_TILE_HEIGHT=216
SMARTCUT_VIEW_GRID_COLS=4
SMARTCUT_VIEW_POLICY_VERSION=views@1.0

# OpenAI 兼容 VLM。未配置 base_url/model 时完全禁用视觉调用。
# 若 base_url 与 DeepSeek 相同可复用 DeepSeek Key；否则请单独提供 VISION_API_KEY。
SMARTCUT_VISION_BASE_URL=
SMARTCUT_VISION_MODEL=
VISION_API_KEY=
SMARTCUT_VISION_TIMEOUT_SECONDS=90
SMARTCUT_VISION_JSON_MODE=false
SMARTCUT_VISION_MAX_IMAGES=7
SMARTCUT_VISION_IMAGE_MAX_EDGE=1024
SMARTCUT_VISION_IMAGE_MAX_BYTES=4194304
SMARTCUT_VISION_TOTAL_MAX_BYTES=12582912
SMARTCUT_VISION_MAX_KEYFRAMES_PER_CHAPTER=2
SMARTCUT_VISION_PROMPT_VERSION=v1
# 使用 M0 视觉证据（Txx 标签）替代旧 contact sheet/keyframes；失败自动回退
SMARTCUT_VISION_USE_EVIDENCE=true

# 策略文件目录（默认读取包内 src/smartcut/policies）
# SMARTCUT_POLICY_DIR=./src/smartcut/policies
